{
  "screenId": "home",
  "version": 4,
  "metadata": {
    "title": "Catalog",
    "analytics": { "screenName": "catalog_home" },
    "cachePolicy": "stale-while-revalidate",
    "cacheTTL": 300
  },
  "overlay": [
    {
      "id": "schema-dock",
      "type": "Touchable",
      "analytics": { "clickEvent": "dock_click" },
      "style": {
        "position": "absolute",
        "left": 16,
        "right": 16,
        "bottom": 16,
        "backgroundColor": "#4F46E5",
        "borderRadius": 16,
        "paddingHorizontal": 16,
        "paddingVertical": 14,
        "flexDirection": "row",
        "justifyContent": "space-between",
        "alignItems": "center"
      },
      "actions": {
        "onPress": {
          "type": "showBottomSheet",
          "payload": {
            "title": "This bar came from the schema",
            "message": "Swap the JSON and this dock, its copy, and its color change with it.",
            "primaryLabel": "Close"
          }
        }
      },
      "children": [
        {
          "type": "Text",
          "props": { "text": "Schema dock" },
          "style": { "color": "#FFFFFF", "fontWeight": "800", "fontSize": 14 }
        },
        {
          "type": "Text",
          "props": { "text": "Open" },
          "style": { "color": "#E0E7FF", "fontWeight": "700", "fontSize": 13 }
        }
      ]
    }
  ],
  "root": {
    "type": "ScrollView",
    "props": { "showsIndicators": false },
    "style": { "backgroundColor": "#070B14" },
    "children": [
      {
        "id": "catalog-header",
        "type": "Header",
        "analytics": {
          "impressionEvent": "header_impression",
          "clickEvent": "header_click"
        },
        "props": {
          "title": "Atelier",
          "subtitle": "A catalog shipped entirely as JSON",
          "searchPlaceholder": "Search objects, rooms, materials",
          "accentColor": "#818CF8"
        },
        "actions": {
          "onPress": {
            "type": "showBottomSheet",
            "payload": {
              "title": "Atelier",
              "message": "The header title, color, and actions are fields on this node.",
              "primaryLabel": "Done"
            }
          },
          "onSearchPress": {
            "type": "navigate",
            "payload": { "screen": "explore" }
          }
        }
      },
      {
        "type": "IconRow",
        "props": {
          "title": "ROOMS",
          "stateKey": "activeCategory",
          "accentColor": "#818CF8",
          "items": [
            {
              "id": "Studio",
              "label": "Studio",
              "image": "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=300&q=80"
            },
            {
              "id": "Home",
              "label": "Home",
              "image": "https://images.unsplash.com/photo-1545454675-3531b543be5d?w=300&q=80"
            },
            {
              "id": "Travel",
              "label": "Travel",
              "image": "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=300&q=80"
            }
          ]
        }
      },
      {
        "type": "ConditionalRender",
        "condition": { "expression": "{{user.isPremium}}" },
        "ifTrue": {
          "type": "PremiumBanner",
          "props": {
            "title": "Member pricing is on",
            "message": "This branch renders because user.isPremium is true."
          }
        },
        "ifFalse": {
          "type": "UpgradeCTA",
          "props": {
            "title": "Unlock member pricing",
            "message": "The other branch is a different component in the same JSON node.",
            "buttonText": "Switch member state"
          }
        }
      },
      {
        "type": "ChipGroup",
        "props": {
          "stateKey": "activeCategory",
          "accentColor": "#4F46E5",
          "chips": [
            { "id": "All", "label": "All" },
            { "id": "Featured", "label": "Featured" },
            { "id": "OnSale", "label": "On sale" },
            { "id": "TopRated", "label": "Top rated" }
          ]
        }
      },
      {
        "type": "SectionHeader",
        "props": {
          "title": "Selected for you",
          "subtitle": "Filtered by the chip and room state above",
          "showSeeAll": true
        },
        "actions": {
          "onSeeAll": {
            "type": "navigate",
            "payload": { "screen": "explore" }
          }
        }
      },
      {
        "type": "HorizontalList",
        "props": { "itemSpacing": 14 },
        "dataSource": {
          "type": "state",
          "stateKey": "activeCategory",
          "filters": {
            "Featured": { "field": "featured", "operator": "eq", "value": true },
            "OnSale": { "field": "badge", "operator": "truthy" },
            "TopRated": { "field": "rating", "operator": "gte", "value": 4.5 }
          },
          "data": [
            {
              "id": "item_lamp",
              "title": "Arc floor lamp",
              "subtitle": "Brass stem, linen shade",
              "category": "Studio",
              "meta": "Studio",
              "price": "$180",
              "compareAt": "$220",
              "badge": "New",
              "featured": true,
              "rating": 4.8,
              "image": "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=600&q=80"
            },
            {
              "id": "item_pack",
              "title": "Field pack",
              "subtitle": "Waxed canvas, 18L",
              "category": "Travel",
              "meta": "Travel",
              "price": "$96",
              "featured": false,
              "rating": 4.1,
              "image": "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=80"
            },
            {
              "id": "item_speaker",
              "title": "Shelf speaker",
              "subtitle": "Walnut cabinet",
              "category": "Home",
              "meta": "Home",
              "price": "$240",
              "compareAt": "$280",
              "badge": "Sale",
              "featured": true,
              "rating": 4.7,
              "image": "https://images.unsplash.com/photo-1545454675-3531b543be5d?w=600&q=80"
            }
          ]
        },
        "itemTemplate": {
          "type": "Card",
          "analytics": { "clickEvent": "card_click", "properties": { "list": "selected" } },
          "style": { "width": 220 },
          "props": {
            "title": "{{item.title}}",
            "subtitle": "{{item.subtitle}}",
            "meta": "{{item.meta}}",
            "price": "{{item.price}}",
            "compareAt": "{{item.compareAt}}",
            "badge": "{{item.badge}}",
            "image": "{{item.image}}",
            "actionLabel": "Details",
            "accentColor": "#4F46E5"
          },
          "actions": {
            "onPress": {
              "type": "showBottomSheet",
              "payload": {
                "title": "{{item.title}}",
                "message": "{{item.subtitle}} · {{item.price}}",
                "primaryLabel": "Close"
              }
            }
          }
        }
      },
      {
        "type": "SectionHeader",
        "props": {
          "title": "Also in the schema",
          "subtitle": "Same card component, different layout width"
        }
      },
      {
        "type": "VerticalList",
        "props": { "gap": 16 },
        "dataSource": {
          "type": "state",
          "stateKey": "activeCategory",
          "filters": {
            "Featured": { "field": "featured", "operator": "eq", "value": true },
            "OnSale": { "field": "badge", "operator": "truthy" },
            "TopRated": { "field": "rating", "operator": "gte", "value": 4.5 }
          },
          "data": [
            {
              "id": "item_cup",
              "title": "Stoneware cup",
              "subtitle": "Speckled glaze",
              "category": "Home",
              "meta": "Home",
              "price": "$28",
              "badge": "Sale",
              "featured": true,
              "rating": 4.6,
              "image": "https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?w=600&q=80"
            },
            {
              "id": "item_notes",
              "title": "Cloth notebook",
              "subtitle": "Plain pages, 192",
              "category": "Studio",
              "meta": "Studio",
              "price": "$18",
              "featured": false,
              "rating": 4.0,
              "image": "https://images.unsplash.com/photo-1516414447565-b14be0adf13e?w=600&q=80"
            }
          ]
        },
        "itemTemplate": {
          "type": "Card",
          "analytics": { "clickEvent": "card_click", "properties": { "list": "also" } },
          "style": { "width": "100%" },
          "props": {
            "title": "{{item.title}}",
            "subtitle": "{{item.subtitle}}",
            "meta": "{{item.meta}}",
            "price": "{{item.price}}",
            "badge": "{{item.badge}}",
            "image": "{{item.image}}",
            "accentColor": "#4F46E5"
          },
          "actions": {
            "onPress": {
              "type": "showToast",
              "payload": {
                "title": "{{item.title}}",
                "message": "Action payload is also templated from the item."
              }
            }
          }
        }
      },
      { "type": "Spacer", "props": { "size": 96 } }
    ]
  }
}
