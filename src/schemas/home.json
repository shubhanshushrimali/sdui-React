{
  "screenId": "home",
  "version": 3,
  "metadata": {
    "title": "Swiggy & Zomato SDUI",
    "analytics": { "screenName": "swiggy_home_v3" },
    "cachePolicy": "stale-while-revalidate",
    "cacheTTL": 300
  },
  "root": {
    "type": "ScrollView",
    "props": { "showsIndicators": false },
    "style": { "backgroundColor": "#070B14" },
    "children": [
      {
        "type": "SwiggyHeader",
        "props": {
          "locationTitle": "Home",
          "locationAddress": "100ft Road, Indiranagar, Bengaluru",
          "searchPlaceholder": "Search 'Biryani', 'Cold Coffee', 'Burgers'..."
        },
        "actions": {
          "onLocationPress": {
            "type": "showToast",
            "payload": {
              "title": "Location Selector",
              "message": "Swiggy SDUI: Location changed to Indiranagar, Bengaluru"
            }
          },
          "onSearchPress": {
            "type": "navigate",
            "payload": { "screen": "explore" }
          }
        }
      },
      {
        "type": "CategoryStoryCircles",
        "props": {
          "title": "WHAT'S ON YOUR MIND?",
          "categories": [
            {
              "id": "biryani",
              "label": "Biryani",
              "image": "https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=300&q=80"
            },
            {
              "id": "pizza",
              "label": "Pizza",
              "image": "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=300&q=80"
            },
            {
              "id": "burgers",
              "label": "Burgers",
              "image": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=300&q=80"
            },
            {
              "id": "rolls",
              "label": "Rolls",
              "image": "https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?w=300&q=80"
            },
            {
              "id": "desserts",
              "label": "Desserts",
              "image": "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=300&q=80"
            },
            {
              "id": "coffee",
              "label": "Cold Brew",
              "image": "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=300&q=80"
            }
          ]
        }
      },
      {
        "type": "ConditionalRender",
        "condition": {
          "expression": "{{user.isPremium}}"
        },
        "ifTrue": {
          "type": "PremiumBanner",
          "props": {
            "title": "👑 ZOMATO GOLD / SWIGGY ONE ACTIVE",
            "message": "Unlimited Free Deliveries on orders above ₹149 • Extra 15% discount applied automatically on all restaurants."
          }
        },
        "ifFalse": {
          "type": "UpgradeCTA",
          "props": {
            "title": "Join Swiggy One / Gold VIP",
            "message": "Save an average of ₹4,200/year with 0 delivery fee and exclusive VIP dining privileges.",
            "buttonText": "Get 3 Months for ₹149"
          }
        }
      },
      {
        "type": "ChipGroup",
        "props": {
          "chips": [
            { "id": "All", "label": "🍽️ All Cuisines" },
            { "id": "Fast", "label": "⚡ Fast (<25m)" },
            { "id": "PureVeg", "label": "🌱 Pure Veg" },
            { "id": "TopRated", "label": "★ 4.5+ Rating" },
            { "id": "Offers", "label": "🏷️ Great Offers" }
          ]
        }
      },
      {
        "type": "SectionHeader",
        "props": {
          "title": "Top Picks For You",
          "subtitle": "Most ordered in Indiranagar right now",
          "showSeeAll": true
        },
        "actions": {
          "onSeeAll": {
            "type": "navigate",
            "payload": { "screen": "explore" }
          }
        }
      },
      {
        "type": "HorizontalList",
        "props": { "itemSpacing": 14 },
        "dataSource": {
          "type": "local",
          "data": [
            {
              "id": "food_1",
              "title": "Special Dum Chicken Biryani",
              "restaurant": "Meghana Foods",
              "cuisine": "Biryani • Andhra • Spicy",
              "rating": "4.6",
              "deliveryTime": "20-25 mins",
              "distance": "1.8 km",
              "price": "₹310",
              "originalPrice": "₹380",
              "discountRibbon": "60% OFF UP TO ₹120",
              "isVeg": false,
              "image": "https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=600&q=80"
            },
            {
              "id": "food_2",
              "title": "Farmhouse Truffle Pizza",
              "restaurant": "Brik Oven Gourmet",
              "cuisine": "Pizza • Italian • Wood-fired",
              "rating": "4.7",
              "deliveryTime": "30-35 mins",
              "distance": "2.4 km",
              "price": "₹450",
              "originalPrice": "₹550",
              "discountRibbon": "FLAT ₹150 OFF",
              "isVeg": true,
              "image": "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600&q=80"
            },
            {
              "id": "food_3",
              "title": "All-American Cheeseburger",
              "restaurant": "Truffles Cafe",
              "cuisine": "Burgers • American • Shakes",
              "rating": "4.5",
              "deliveryTime": "25-30 mins",
              "distance": "1.2 km",
              "price": "₹260",
              "originalPrice": "₹320",
              "discountRibbon": "20% OFF",
              "isVeg": false,
              "image": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&q=80"
            }
          ]
        },
        "itemTemplate": {
          "type": "RestaurantDishCard",
          "style": { "width": 260 },
          "props": {
            "id": "{{item.id}}",
            "title": "{{item.title}}",
            "restaurant": "{{item.restaurant}}",
            "cuisine": "{{item.cuisine}}",
            "rating": "{{item.rating}}",
            "deliveryTime": "{{item.deliveryTime}}",
            "distance": "{{item.distance}}",
            "price": "{{item.price}}",
            "originalPrice": "{{item.originalPrice}}",
            "discountRibbon": "{{item.discountRibbon}}",
            "isVeg": "{{item.isVeg}}",
            "image": "{{item.image}}"
          }
        }
      },
      {
        "type": "SectionHeader",
        "props": {
          "title": "Trending Dishes Around You",
          "subtitle": "Hand-picked culinary bestsellers"
        }
      },
      {
        "type": "VerticalList",
        "props": { "gap": 16 },
        "dataSource": {
          "type": "local",
          "data": [
            {
              "id": "v_food_1",
              "title": "Afghani Malai Chicken Tikka",
              "restaurant": "The Great Indian Kebab Factory",
              "cuisine": "Mughlai • Tandoor • North Indian",
              "rating": "4.8",
              "deliveryTime": "25-30 mins",
              "distance": "2.8 km",
              "price": "₹380",
              "originalPrice": "₹450",
              "discountRibbon": "FLAT ₹100 OFF",
              "isVeg": false,
              "image": "https://images.unsplash.com/photo-1599488615731-7e5c2823ff28?w=600&q=80"
            },
            {
              "id": "v_food_2",
              "title": "Double Chocolate Belgian Waffle",
              "restaurant": "Belgian Waffle Co.",
              "cuisine": "Desserts • Waffles • Shakes",
              "rating": "4.7",
              "deliveryTime": "15-20 mins",
              "distance": "1.0 km",
              "price": "₹190",
              "originalPrice": "₹240",
              "discountRibbon": "BESTSELLER",
              "isVeg": true,
              "image": "https://images.unsplash.com/photo-1562376552-0d160a2f238d?w=600&q=80"
            }
          ]
        },
        "itemTemplate": {
          "type": "RestaurantDishCard",
          "style": { "width": "100%" },
          "props": {
            "id": "{{item.id}}",
            "title": "{{item.title}}",
            "restaurant": "{{item.restaurant}}",
            "cuisine": "{{item.cuisine}}",
            "rating": "{{item.rating}}",
            "deliveryTime": "{{item.deliveryTime}}",
            "distance": "{{item.distance}}",
            "price": "{{item.price}}",
            "originalPrice": "{{item.originalPrice}}",
            "discountRibbon": "{{item.discountRibbon}}",
            "isVeg": "{{item.isVeg}}",
            "image": "{{item.image}}"
          }
        }
      },
      {
        "type": "Spacer",
        "props": { "size": 80 }
      }
    ]
  }
}
